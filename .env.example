PORT=7860
HF_HOME=/root/.cache/huggingface

# Model names
POLICY_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
REWARD_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
REWARD_BACKEND=regression

# Reward model training
REWARD_TRAIN_EPISODES_PER_TASK=4
REWARD_TRAIN_EPOCHS=1
REWARD_TRAIN_BATCH_SIZE=1
REWARD_TRAIN_GRAD_ACCUM=8
REWARD_TRAIN_MAX_LENGTH=1024
REWARD_TRAIN_USE_4BIT=true
REWARD_MODEL_OUTPUT_DIR=artifacts/reward_model

# Policy model training
POLICY_TRAIN_EPISODES_PER_TASK=4
POLICY_TRAIN_EPOCHS=1
POLICY_TRAIN_BATCH_SIZE=1
POLICY_TRAIN_GRAD_ACCUM=8
POLICY_TRAIN_MAX_LENGTH=768
POLICY_TRAIN_USE_4BIT=true
POLICY_MODEL_OUTPUT_DIR=artifacts/policy_model

# Shared outputs
TRAIN_RESULTS_DIR=results
